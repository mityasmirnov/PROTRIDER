manifest {
    name            = 'protrider-nextflow'
    description     = 'Stub Nextflow workflow: protrider run + plot all'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
}

params {
    intensities        = "${projectDir}/../sample_data/protrider_sample_dataset.tsv"
    sample_annotation  = "${projectDir}/../sample_data/sample_annotations.tsv"
    config             = "${projectDir}/../config.yaml"
    outdir             = "${projectDir}/../results_nf"
    index_col          = "protein_ID"
    device             = "cpu"
    n_epochs           = 5
    find_q_method      = "OHT"
}

process {
    executor = 'local'
    cpus     = 2
    memory   = '4 GB'
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}
